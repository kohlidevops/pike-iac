  "outputs": {
    "roleDefinitionGuid": {
      "type": "string",
      "value": "[reference(extensionResourceId(tenantResourceId('Microsoft.Management/managementGroups', parameters('targetManagementGroupName')), 'Microsoft.Resources/deployments', 'deploy-pike-rbac-grantor-role'), '2025-04-01').outputs.roleDefinitionGuid.value]"
    },
    "roleDefinitionId": {
      "type": "string",
      "value": "[reference(extensionResourceId(tenantResourceId('Microsoft.Management/managementGroups', parameters('targetManagementGroupName')), 'Microsoft.Resources/deployments', 'deploy-pike-rbac-grantor-role'), '2025-04-01').outputs.roleDefinitionId.value]"
    }
  }
}